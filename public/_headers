# Cloudflare Pages response headers. Copied into out/ at build time.

# Keep preview and pages.dev copies out of search. Only getbusinessbrain.ai is indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://snap.licdn.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://challenges.cloudflare.com https://static.cloudflareinsights.com https://ou.chat https://chat.omazy.ai; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://www.facebook.com https://px.ads.linkedin.com https://www.google.com https://googleads.g.doubleclick.net https://cloudflareinsights.com https://ou.chat https://chat.omazy.ai https://*.omazy.ai; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://www.youtube-nocookie.com https://www.googletagmanager.com https://challenges.cloudflare.com https://td.doubleclick.net https://www.facebook.com https://ou.chat https://chat.omazy.ai; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/login
  X-Robots-Tag: noindex

/login/*
  X-Robots-Tag: noindex

/dashboard
  X-Robots-Tag: noindex

/dashboard/*
  X-Robots-Tag: noindex

/thanks/*
  X-Robots-Tag: noindex

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Generated share images have no file extension, so set the type explicitly.
/products/*/opengraph-image
  Content-Type: image/png

/industries/*/opengraph-image
  Content-Type: image/png
